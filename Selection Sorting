#program for Selection Sort
A = [8, 2, 0, 4, 6, 5, 7]

for i in range(len(A)):
    min_id = i
    for j in range (i+1, len(A)):
        if A[min_id] > A[j]:
            A[min_id], A[j] = A[j], A[min_id]
            
print(A)
print("Sorted Array: ")
for i in range(len(A)):
    print("%d" %A[i], end=" ")
