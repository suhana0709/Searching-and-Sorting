#Merge Sort
def merge_sort(a):
    if len(a) > 1:
        mid = len(a) // 2
        right = a[mid:]
        left = a[:mid]
        
        #recursive call in each half
        merge_sort(right)
        merge_sort(left)
        
        #two iterations for travelling the two halves
        i = 0
        j = 0
        
        #iteration for main array
        k = 0
        
        while i<len(left) and j<len(right):
            if left[i] <= right[j]:
                #the value from the left half has been uesd
                a[k] = left[i]
                i += 1
            else:
                a[k] = right[j]
                j += 1
            
             #Move to the next slot
            k += 1
            
        #for all the remaining values
        while i<len(left):
            a[k] = left[i]
            i += 1
            k+=1
        while j < len(right):
            a[k] = right[j]
            j+=1
            k+=1
            
            
a = [6, 8, 9, 4, 7, 4, 3, 5, 1, 0, 2]
print("Given Array: ",a)
merge_sort(a)
print("Sorted Array:",a)
