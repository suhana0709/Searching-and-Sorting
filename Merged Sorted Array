#merging two sorted arrays using merge sort
def merge(a1, a2):
    i = j = 0
    merged = []
    #compare elements from both arrays
    while i < len(a1) and j < len(a2):
        if a1[i] <= a2[j]:
            merged.append(a1[i])
            i += 1
        else:
            merged.append(a2[j])
            j += 1
    #add remaining elements(if anY)
    while i<len(a1):
        merged.append(a1[i])
        i+=1
    while j<len(a2):
        merged.append(a2[j])
        j+=1
    return merged
        
a1 = [0, 1, 2, 3, 4]
a2 = [5, 6, 7, 8, 9]
print("Array no.1: ",a1)
print("Array no.2: ",a2)
result = merge(a1, a2)
print("\nMerged Sorted Array:- ")
print(result)
